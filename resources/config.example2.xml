			<menuitem name="和剪貼簿裡面的檔案比較" class="* folder">&quot;${var:KDiff3}&quot; &quot;%1&quot; &quot;%c0&quot; -o &quot;%1&quot;</menuitem>
			<menuitem name="合併選取的檔案" class="* folder">&quot;${var:KDiff3}&quot; &quot;%1&quot; &quot;%2&quot; &quot;%3&quot; -o &quot;%1&quot;</menuitem>
		</menu>

		<var name="WinMerge">${var:SoftBase}\_dev_\WinMerge\WinMergeU.exe</var>
