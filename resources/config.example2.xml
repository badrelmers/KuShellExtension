		<menuitem name="Gitk" class="folder" icon="${var:GitIcon}" console="false" workdir=".\">&quot;${var:GitDir}\cmd\gitk.cmd&quot;</menuitem>
		<menuitem name="Git GUI" class="folder" icon="${var:GitIcon}" console="false" workdir=".\">&quot;${var:GitDir}\cmd\git.cmd&quot; gui</menuitem>

		<menuitem name="My&amp;Rename" class="folder">&quot;${var:SoftBase}\_util_\MyRename\MyRename.exe&quot; &quot;%1&quot;</menuitem>
		<menuitem name="Ku&amp;Finder" class="folder">&quot;${var:SoftBase}\_image_\KuViewer\KuFinder.exe&quot; &quot;%1&quot;</menuitem>
