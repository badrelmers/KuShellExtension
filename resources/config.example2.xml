		<menuitem name="KillBox" class="* folder" multiple="0">&quot;${var:SoftBase}\_util_\KillBox.exe&quot; &quot;%1&quot;</menuitem>
		<menuitem name="Show Short Path" class="* folder">&quot;${env:comspec}&quot; /c &quot;echo %~s1 &amp;&amp; pause&quot;</menuitem>

		<menuitem name="----" class="* folder" />

		<menuitem name="重新整理" class="* folder" icon="${var:IconDir}\Help.ico" action="builtin" multiple="0">Reload</menuitem>
		<menuitem name="編輯設定" class="* folder" icon="${var:IconDir}\Settings.ico" multiple="0">&quot;${var:editor}&quot; &quot;${var:CONFIG}&quot;</menuitem>
		<menu name="Debug" class="hidden">
			<menuitem name="Debug">
				&quot;${env:comspec}&quot; /c &quot;
					echo Arch: ${var:Arch}, ${var:ArchName} &amp;&amp;
					echo SysDir: ${var:SysDir}, ${var:SysDir32}, ${var:SysDir64} &amp;&amp;
					echo ProgramFiles: ${var:ProgramFiles}, ${var:ProgramFiles32}, ${var:ProgramFiles64} &amp;&amp;
					echo Documents: ${var:Documents}, ${var:CommonDocuments} &amp;&amp;
					echo Pictures: ${var:Pictures}, ${var:CommonPictures} &amp;&amp;
					echo Music: ${var:Music}, ${var:CommonMusic} &amp;&amp;
					echo Video: ${var:Video}, ${var:CommonVideo} &amp;&amp;
					echo Desktop: ${var:Desktop}, ${var:CommonDesktop} &amp;&amp;
					echo Startup: ${var:Startup}, ${var:CommonStartup} &amp;&amp;
				pause&quot;
			</menuitem>
		</menu>
	</menu>
</config>
