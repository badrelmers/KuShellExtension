			<menuitem name="和剪貼簿裡面的檔案比較" class="* folder">&quot;${var:WinMerge}&quot; /r &quot;%1&quot; &quot;%c0&quot;</menuitem>
			<menuitem name="解決衝突">&quot;${var:WinMerge}&quot; &quot;%1&quot;</menuitem>
		</menu>

		<menu name="比較檔案" icon="${var:IconDir}\Find.ico">
			<menuitem name="比較選取的檔案">&quot;${var:SysDir64}\comp.exe&quot; &quot;%1&quot; &quot;%2&quot;</menuitem>
			<menuitem name="和剪貼簿裡面的檔案比較">&quot;${var:SysDir64}\comp.exe&quot; &quot;%1&quot; &quot;%c0&quot;</menuitem>
		</menu>

		<menuitem name="----" class="* folder" />

		<var name="GitDir">${var:SoftBase}\_dev_\Git</var>
