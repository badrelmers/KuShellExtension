		<!-- <menuitem name="Mp3Tag" class="folder">&quot;${var:SoftBase}\_media_\_util_\Mp3tag\Mp3tag.exe&quot; &quot;%1&quot;</menuitem> -->
		<menuitem name="MiniWebSvr" class="folder" icon="${var:IconDir}\Phone.ico">&quot;${var:SoftBase}\_net_\MiniWebSvr\miniweb.exe&quot; -p 45012 --nolog</menuitem>
		<menuitem name="ArtIcons Pro" class="${var:ico}">&quot;${var:SoftBase}\_image_\ArtIcons Pro\ArtIcons.exe&quot; &quot;%1&quot;</menuitem>
		<menuitem name="IconsExt" class="${var:ico}">&quot;${var:SoftBase}\_util_\iconsext\iconsext.exe&quot; /save &quot;%~s1&quot; &quot;${var:SoftBase}\_ui_\RKLauncher\top\icons\temp&quot; -icons</menuitem>
		<menuitem name="ResHacker" class=".exe .res ${var:dll}">&quot;${var:SoftBase}\_util_\ResHacker\ResHacker.exe&quot; &quot;%1&quot;</menuitem>
		<menuitem name="XNResourceEditor" class=".exe .res ${var:dll}">&quot;${var:SoftBase}\_util_\XNResourceEditor.exe&quot; &quot;%1&quot;</menuitem>

		<var name="DllExp">${var:SoftBase}\_dev_\dllexp\dllexp.exe</var>
		<var name="DllExp64">${var:SoftBase}\_dev_\dllexp\dllexp64.exe</var>
		<menu name="DLL Export Viewer" icon="${var:DllExp}">
			<for bits="32 64" prog="&quot;${var:DllExp}&quot; &quot;${var:DllExp64}&quot;">
				<for class="&quot;${var:dll}&quot; folder" opt1="/from_textfile &quot;/subfolders /from_files&quot;" opt2="%l %1\*.dll">
					<menuitem name="${var:bits}bit" class="${var:class}">&quot;${var:prog}&quot; ${var:opt1} &quot;${var:opt2}&quot;</menuitem>
				</for>
			</for>
		</menu>

