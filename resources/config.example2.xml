		<var name="KuHasher">${var:SoftBase}\_util_\KuHasher\KuHasher</var>
		<menu name="KuHasher" icon="${var:IconDir}\BioHazard.ico">
			<for algo="MD5 SHA-1 CRC32 ED2K ED2K-AICH" txt="md5.txt sha1.txt crc32.txt ed2k.txt">
				<menuitem name="----" class="* folder" />
				<menuitem name="${var:algo}">&quot;${var:KuHasher}.cmd&quot; -m ${var:algo} %~nx*</menuitem>
				<menuitem name="${var:algo}" class="folder">&quot;${var:KuHasher}.cmd&quot; -m ${var:algo} *</menuitem>
				<menuitem name="Save ${var:algo} sums" console="false">&quot;${var:KuHasher}.exe&quot; -m ${var:algo} -o ${var:txt} %~nx*</menuitem>
				<menuitem name="Save ${var:algo} sums" class="folder" console="false">&quot;${var:KuHasher}.exe&quot; -m ${var:algo} -o ${var:txt} *</menuitem>
				<menuitem name="Check ${var:algo} sums">&quot;${var:KuHasher}.cmd&quot; -m ${var:algo} -c %*</menuitem>
				<!-- <menuitem name="Check ${var:algo} sums" class="folder">&quot;${var:KuHasher}.cmd&quot; -m ${var:algo} -c ${var:txt}</menuitem> -->
			</for>
		</menu>

		<menuitem name="BEncode Editor" class=".torrent">&quot;${var:SoftBase}\_util_\BEncode Editor\BEncode Editor.exe&quot; &quot;%1&quot;</menuitem>
